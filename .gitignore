# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
next-env.d.ts

# Generated from the vault by the extract scripts (prebuild). Never hand-edited, and never
# committed — the vault is the only source of truth, and these would otherwise duplicate
# private-repo content into a public one.
content/blog/
content/roadmap/
content/garden/

# Cloudflare / wrangler
.wrangler/
.dev.vars

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# NOTE: design/ is intentionally NOT ignored — it holds ground-truth mockups and hero
# composites used as build references. It is excluded from the DEPLOY path (see
# design/README.md), not from version control.
